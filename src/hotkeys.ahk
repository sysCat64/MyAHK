#Requires AutoHotkey v2.0

; ====================================
; hotkeys.ahk - ホットキー定義
; ====================================
; 全てのホットキー・ホットストリングを一元管理します。
; 衝突を避けるため、グローバルショートカットはこのファイルで集中管理します。

; ライブラリのインクルード
#Include lib\log.ahk

; ====================================
; サンプルホットキー
; ====================================

; Ctrl+Alt+T: テストメッセージを表示
^!t:: {
    log("テストホットキーが押されました")
    MsgBox("ホットキーのテストです`nCtrl+Alt+T が押されました", "MyAHK")
}

; Ctrl+Alt+R: スクリプトをリロード
^!r:: {
    log("スクリプトをリロードします")
    Reload()
}

; ====================================
; サンプルホットストリング
; ====================================

; 「ahkv2」と入力すると「AutoHotkey v2」に展開
:*:ahkv2::AutoHotkey v2

; ====================================
; アプリケーション固有のホットキー
; ====================================
; 特定のアプリケーションでのみ有効なホットキーは、
; #HotIf ディレクティブを使用して条件を指定します。

; メモ帳がアクティブな場合のみ有効なホットキー例
#HotIf WinActive("ahk_class Notepad")
^!n:: {
    log("メモ帳専用ホットキーが押されました")
    MsgBox("メモ帳でCtrl+Alt+Nが押されました", "MyAHK")
}
#HotIf
