#Requires AutoHotkey v2.0

; ====================================
; main.ahk - エントリースクリプト
; ====================================
; このスクリプトは MyAHK プロジェクトのエントリーポイントです。
; 必要なライブラリとモジュールをインクルードし、初期化処理を行います。

; ライブラリのインクルード
#Include lib\log.ahk

; モジュールのインクルード
#Include hotkeys.ahk

; ====================================
; 初期化処理
; ====================================

; スクリプト起動時の設定
A_TrayMenu.Delete()
A_TrayMenu.Add("終了", (*) => ExitApp())

; 起動ログ
log("MyAHK スクリプトが起動しました")

; ====================================
; メイン処理
; ====================================

; スクリプトを常駐させる
Persistent()

log("スクリプトの初期化が完了しました")
